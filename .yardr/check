#!/bin/sh
# The merge gate of depot finance: yardr depot check runs it in a bead's worktree, and
# a bead lands only when it exits 0. yardr reads this file from the base
# branch (main), so an edit here counts once it has landed there.
set -e
# erp-e71y, after the quiet run of 2026-10-21 (main 68cc5207): a checkout outside $HOME bind-mounted an empty
# bi_finance into the image, and the tests failed with 'No module named bi_finance'. Colima on the mini mounts
# only the home folder, so stop here, before any docker call, and name the cause. GATE_ANY_PATH=1 skips the
# guard, for a host whose docker can see other paths.
if [ "${GATE_ANY_PATH:-}" != 1 ]; then
  CHECKOUT=$(pwd -P)
  HOME_REAL=$(cd "$HOME" && pwd -P)
  case "$CHECKOUT/" in
  "$HOME_REAL"/*) ;;
  *)
    echo "gate: checkout $CHECKOUT is not under \$HOME $HOME_REAL: Colima mounts only the home folder, so docker sees an empty bi_finance (GATE_ANY_PATH=1 skips this guard)" >&2
    exit 2
    ;;
  esac
fi
# The host part (the erp-5x04 guard, the compose config checks and the stdlib unittest lines)
# lives in .yardr/check-host.sh, and GitHub CI (.github/workflows/finance-tests.yml) calls the
# same file, so the two callers cannot drift apart. What stays here is what a GitHub runner
# cannot do: the frappe-image run (it needs the custom image, built locally) and upstream's
# pre-commit (upstream's lint workflow does that).
sh .yardr/check-host.sh
# The bi_finance test modules that import frappe need the image: every one of them runs here, in one container
# start, so a change to a synced JSON cannot leave one of them red on main unseen (erp-jta3). The image is the tag
# gate-image.sh picks: main's deploy pin first, so a branch cut before the last switch still runs (erp-0f93); mounted
# read-only, no ports, as finance/docs/payment-runs.md does.
# frappe's logger writes ../logs from the working directory (apps/logs here) when erpnext is imported, so that folder is made too.
# A flake that depends on the clock (erp-c7wk) blocks a landing here instead of hiding in the how-to.
IMAGE=$(sh finance/scripts/gate-image.sh)
docker run --rm -v "$PWD/finance/apps/bi_finance:/home/frappe/frappe-bench/apps/bi_finance:ro" "$IMAGE" \
  sh -c 'mkdir -p /home/frappe/logs /home/frappe/frappe-bench/apps/logs && cd /home/frappe/frappe-bench/apps/bi_finance && ../../env/bin/python -m unittest bi_finance.test_payment_run bi_finance.test_treasury bi_finance.test_bank_list bi_finance.test_bank_statement_upload bi_finance.test_cash_flow_forecast bi_finance.test_cash_position bi_finance.test_paypal bi_finance.test_paypal_sync bi_finance.test_qrbill bi_finance.test_setup bi_finance.test_wise'
# The checkout guard above, offline: a stub docker stands in for the real one (erp-e71y).
(cd finance/scripts && python3 -m unittest test_gate_check)
# Upstream's own lint, required: a red lint must stop the landing here, not pass unseen (erp-jmmz).
if ! command -v pre-commit >/dev/null; then
  echo "pre-commit not installed" >&2
  exit 2
fi
# validate-compose (language: system) invokes `python`; a GitHub runner has it, a dev Mac
# may have only python3 (whose /usr/bin stub even refuses to run under another name). A
# private wrapper for the pre-commit call keeps the gate self-contained; the lint is unchanged.
if ! command -v python >/dev/null 2>&1; then
  PYSHIM=$(mktemp -d)
  printf '#!/bin/sh\nexec python3 "$@"\n' >"$PYSHIM/python"
  chmod +x "$PYSHIM/python"
  PATH="$PYSHIM:$PATH"
  export PATH
fi
pre-commit run --all-files
