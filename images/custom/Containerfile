# syntax=docker/dockerfile:1
ARG PYTHON_VERSION=3.14
ARG DEBIAN_BASE=trixie
FROM python:${PYTHON_VERSION}-slim-${DEBIAN_BASE} AS base

COPY resources/core/nginx/nginx-template.conf /templates/nginx/frappe.conf.template
COPY resources/core/nginx/nginx-entrypoint.sh /usr/local/bin/nginx-entrypoint.sh
COPY resources/core/nginx/security_headers.conf /etc/nginx/snippets/security_headers.conf

ARG WKHTMLTOPDF_VERSION=0.12.6.1-3
ARG WKHTMLTOPDF_DISTRO=bookworm
ARG INSTALL_CHROMIUM=true

ARG NODE_VERSION=24
ENV NVM_DIR=/home/frappe/.nvm
ENV NVM_SYMLINK_CURRENT=true
ENV PATH=${NVM_DIR}/current/bin/:${PATH}

RUN useradd -u 1000 -g 0 -d /home/frappe -ms /bin/bash frappe \
    && apt-get update \
    && apt-get install --no-install-recommends -y \
    ca-certificates \
    curl \
    git \
    vim \
    nginx \
    gettext-base \
    file \
    # weasyprint dependencies
    libpango-1.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    # For backups
    restic \
    gpg \
    # MariaDB
    mariadb-client \
    less \
    # Postgres
    libpq-dev \
    postgresql-client \
    # For healthcheck
    wait-for-it \
    jq \
    # For MIME type detection
    media-types \
    && . /etc/os-release \
    && if [ "$VERSION_CODENAME" = "trixie" ]; then \
        apt-get install --no-install-recommends -y tzdata-legacy; \
    fi \
    # NodeJS
    && mkdir -p ${NVM_DIR} \
    && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.6/install.sh | bash \
    && . ${NVM_DIR}/nvm.sh \
    && nvm install ${NODE_VERSION} \
    && nvm use ${NODE_VERSION} \
    && npm install -g yarn \
    && corepack enable pnpm \
    && nvm alias default ${NODE_VERSION} \
    && rm -rf ${NVM_DIR}/.cache \
    && echo 'export NVM_DIR="/home/frappe/.nvm"' >>/home/frappe/.bashrc \
    && echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm' >>/home/frappe/.bashrc \
    && echo '[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion' >>/home/frappe/.bashrc \
    # Install wkhtmltopdf with patched qt
    && if [ "$(uname -m)" = "aarch64" ]; then export ARCH=arm64; fi \
    && if [ "$(uname -m)" = "x86_64" ]; then export ARCH=amd64; fi \
    && downloaded_file=wkhtmltox_${WKHTMLTOPDF_VERSION}.${WKHTMLTOPDF_DISTRO}_${ARCH}.deb \
    && curl -sLO https://github.com/wkhtmltopdf/packaging/releases/download/$WKHTMLTOPDF_VERSION/$downloaded_file \
    && apt-get install -y ./$downloaded_file \
    && rm $downloaded_file \
    # Chromium
    && if [ "$INSTALL_CHROMIUM" != "false" ]; then \
        DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        chromium-headless-shell; \
    fi \
    # Clean up
    && rm -rf /var/lib/apt/lists/* \
    && rm -fr /etc/nginx/sites-enabled/default \
    && mkdir -p /etc/nginx/snippets \
    && pip3 install frappe-bench \
    # Fixes for non-root nginx and logs to stdout
    && sed -i '/user www-data/d' /etc/nginx/nginx.conf \
    && ln -sf /dev/stdout /var/log/nginx/access.log && ln -sf /dev/stderr /var/log/nginx/error.log \
    && touch /run/nginx.pid \
    # OpenShift and arbitrary UID compatibility (GID 0 & group writable)
    && chgrp -R 0 /home/frappe /etc/nginx /var/log/nginx /var/lib/nginx /run \
    && chmod -R g=u /home/frappe /etc/nginx /var/log/nginx /var/lib/nginx /run \
    && chmod 755 /usr/local/bin/nginx-entrypoint.sh \
    && chmod 644 /templates/nginx/frappe.conf.template


FROM base AS builder

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
    # For frappe framework
    wget \
    #for building arm64 binaries
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    # For psycopg2
    libpq-dev \
    # Other
    libffi-dev \
    liblcms2-dev \
    libldap2-dev \
    libmariadb-dev \
    libsasl2-dev \
    libtiff-dev \
    libwebp-dev \
    pkg-config \
    redis-tools \
    rlwrap \
    tk8.6-dev \
    cron \
    # For pandas
    gcc \
    build-essential \
    libbz2-dev \
    && rm -rf /var/lib/apt/lists/*

USER frappe

ARG FRAPPE_BRANCH=v16.51.1
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG CACHE_BUST=""
# Node heap cap for the asset build (bench build, after the frappe patch that makes frappe's
# bundler keep it): finance/scripts/build-image.sh passes --max-old-space-size=$NODE_HEAP_MB
# (default 900), so the build stays inside its capped builder. Coolify uses the same default.
ARG NODE_OPTIONS="--max-old-space-size=900"

# Our patches to fetched apps (finance/patches/<app>), applied after bench init and
# before the .git directories are removed: the patch needs the repository to check against.
COPY --chown=frappe:0 finance/scripts/check_app_pins.py /home/frappe/patches/check_app_pins.py
COPY --chown=frappe:0 finance/scripts/apply-patches.sh /home/frappe/patches/apply-patches.sh
COPY --chown=frappe:0 finance/patches/erpnextswiss /home/frappe/patches/erpnextswiss
COPY --chown=frappe:0 finance/patches/frappe /home/frappe/patches/frappe
COPY --chown=frappe:0 finance/patches/hrms /home/frappe/patches/hrms

RUN --mount=type=secret,id=APPS_JSON,target=/opt/frappe/apps.json,uid=1000,gid=0 \
    --mount=type=secret,id=apps_json,target=/opt/frappe/legacy-apps.json,uid=1000,gid=0 \
  : "${CACHE_BUST}" && \
  APPS_FILE=/opt/frappe/apps.json && \
  if [ ! -s "$APPS_FILE" ]; then APPS_FILE=/opt/frappe/legacy-apps.json; fi && \
  if [ ! -s "$APPS_FILE" ]; then echo "APPS_JSON build secret required" >&2; exit 2; fi && \
  bench_args="--apps_path=$APPS_FILE" && \
  bench init ${bench_args}\
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --skip-assets \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  python3 /home/frappe/patches/check_app_pins.py "$APPS_FILE" apps && \
  echo "{}" > sites/common_site_config.json && \
  sh /home/frappe/patches/apply-patches.sh /home/frappe/patches/erpnextswiss apps/erpnextswiss && \
  sh /home/frappe/patches/apply-patches.sh /home/frappe/patches/frappe apps/frappe && \
  sh /home/frappe/patches/apply-patches.sh /home/frappe/patches/hrms apps/hrms && \
  # The erpnextswiss shell's workspaces, icon and v16 sidebar archive are not shipped: its after_migrate skips each
  # store whose folder is missing, so nothing recreates them (Benchi, 2026-10-12: no Schweizer Buchhaltung on the desk).
  rm -r apps/erpnextswiss/erpnextswiss/erpnextswiss/workspace apps/erpnextswiss/erpnextswiss/desktop_icon apps/erpnextswiss/erpnextswiss/workspace_sidebar && \
  # The asset build runs after the frappe patch: bench init would build before it, and frappe's
  # bundler replaces the NODE_OPTIONS it is given with 75% of the RAM it sees (about 2.9G in the
  # builder VM), so the heap cap never reached the vite build of hrms, which was SIGKILLed.
  bench build --production && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr && \
  # Assets to image-layer storage, and the group-writable modes, both set here: the backend
  # stage copies the bench once. A chmod or cp there copies all of it again into a second layer
  # (2.25G on the live image, on top of the 2.25G copy).
  mv sites/assets assets && \
  chmod -R g=u /home/frappe/frappe-bench

FROM base AS backend

USER frappe

COPY --from=builder --chown=frappe:0 /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
# This entrypoint script link build assets of the image to the mounted sites volume at container initialization
COPY resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]

# Coolify selects this target: one build graph, including the patched upstream apps.
FROM backend AS finance

COPY --chown=frappe:0 finance/apps/bi_finance /home/frappe/frappe-bench/apps/bi_finance
RUN /home/frappe/frappe-bench/env/bin/pip install --no-cache-dir -e /home/frappe/frappe-bench/apps/bi_finance
COPY --chown=frappe:0 finance/apps/bi_payroll /home/frappe/frappe-bench/apps/bi_payroll
RUN /home/frappe/frappe-bench/env/bin/pip install --no-cache-dir -e /home/frappe/frappe-bench/apps/bi_payroll
COPY --chown=frappe:0 finance/scripts/gate-tests.sh finance/scripts/gate-modules.sh /home/frappe/frappe-bench/finance/scripts/

# Preserve the upstream base-only default for callers that do not select finance.
FROM backend AS default
